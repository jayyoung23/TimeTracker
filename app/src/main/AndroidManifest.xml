<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.timetracker">

    <application
        android:name=".TimeTrackerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimeTracker">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.NewProjectActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ProjectDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.TimerActivity"
            android:exported="false" />
            
        <!-- 用于提醒功能的广播接收器 -->
        <receiver android:name=".notification.ReminderReceiver" />
    </application>

</manifest>
